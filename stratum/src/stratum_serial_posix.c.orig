#include "stratum_serial.h"

#include "stratum_continuous.h"

#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <string.h>
#include <termios.h>
#include <time.h>
#include <unistd.h>

static int64_t monotonic_milliseconds(void) {
    struct timespec now;
    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
        return -1;
    }
    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
}

static int serial_write_all(tangminer_serial_t* serial, const uint8_t* bytes, size_t size) {
    size_t written = 0;
    while (written < size) {
        const ssize_t rc = write(serial->fd, bytes + written, size - written);
        if (rc < 0 && errno == EINTR) {
            continue;
        }
        if (rc <= 0) {
            return -1;
        }
        written += (size_t)rc;
    }
    (void)tcdrain(serial->fd);
    return 0;
}

static speed_t baud_to_speed(int baud) {
    switch (baud) {
        case 9600: return B9600;
        case 19200: return B19200;
        case 38400: return B38400;
        case 57600: return B57600;
        case 115200: return B115200;
#ifdef B230400
        case 230400: return B230400;
#endif
#ifdef B460800
        case 460800: return B460800;
#endif
#ifdef B921600
        case 921600: return B921600;
#endif
        default: return B115200;
    }
}

int tangminer_serial_open(tangminer_serial_t* serial, const char* path, int baud) {
    struct termios tio;
    memset(serial, 0, sizeof(*serial));
    serial->fd = -1;
    const int fd = open(path, O_RDWR | O_NOCTTY | O_SYNC);
    if (fd < 0) {
        return -1;
    }
    if (tcgetattr(fd, &tio) != 0) {
        close(fd);
        return -1;
    }
    cfmakeraw(&tio);
    tio.c_cflag |= CLOCAL | CREAD;
#ifdef CRTSCTS
    tio.c_cflag &= ~CRTSCTS;
#endif
    tio.c_cflag &= ~CSTOPB;
    tio.c_cflag &= ~PARENB;
    tio.c_cflag &= ~CSIZE;
    tio.c_cflag |= CS8;
    tio.c_cc[VMIN] = 0;
    tio.c_cc[VTIME] = 0;
    const speed_t speed = baud_to_speed(baud);
    cfsetispeed(&tio, speed);
    cfsetospeed(&tio, speed);
    if (tcsetattr(fd, TCSANOW, &tio) != 0) {
        close(fd);
        return -1;
    }
    tcflush(fd, TCIOFLUSH);
    serial->fd = fd;
    return 0;
}

int tangminer_serial_send_job(tangminer_serial_t* serial, const uint8_t packet[79]) {
    return serial_write_all(serial, packet, 79);
}

int tangminer_serial_send_tagged_job(
    tangminer_serial_t* serial, uint16_t tag, const uint8_t packet[79]) {
    uint8_t tagged_packet[TANGMINER_CONTINUOUS_JOB_PACKET_LEN];
    tangminer_continuous_encode_job(tag, packet, tagged_packet);
    return serial_write_all(serial, tagged_packet, sizeof(tagged_packet));
}

int tangminer_serial_send_stop(tangminer_serial_t* serial) {
    const uint8_t stop[] = {'T', 'N', 'S'};
    return serial_write_all(serial, stop, sizeof(stop));
}

static tangminer_serial_event_t serial_read_event(
    tangminer_serial_t* serial,
    uint16_t* tag,
    uint32_t* nonce,
    int timeout_ms) {
    const int64_t start_ms = monotonic_milliseconds();
    if (start_ms < 0) {
        return TANGMINER_SERIAL_EVENT_ERROR;
    }
    const int64_t deadline_ms = start_ms + timeout_ms;

    while (true) {
        const int64_t now_ms = monotonic_milliseconds();
        if (now_ms < 0) {
            return TANGMINER_SERIAL_EVENT_ERROR;
        }
        int remaining_ms = timeout_ms;
        if (timeout_ms >= 0) {
            const int64_t remaining = deadline_ms - now_ms;
            if (remaining < 0) {
                return TANGMINER_SERIAL_EVENT_TIMEOUT;
            }
            remaining_ms = remaining > INT32_MAX ? INT32_MAX : (int)remaining;
        }

        struct pollfd pfd = {.fd = serial->fd, .events = POLLIN};
        const int poll_rc = poll(&pfd, 1, remaining_ms);
        if (poll_rc < 0 && errno == EINTR) {
            continue;
        }
        if (poll_rc == 0) {
            return TANGMINER_SERIAL_EVENT_TIMEOUT;
        }
        if (poll_rc < 0 || (pfd.revents & (POLLERR | POLLNVAL)) != 0 ||
            (pfd.revents & POLLIN) == 0) {
            return TANGMINER_SERIAL_EVENT_ERROR;
        }

        uint8_t byte = 0;
        const ssize_t rc = read(serial->fd, &byte, 1);
        if (rc < 0 && errno == EINTR) {
            continue;
        }
        if (rc <= 0) {
            return TANGMINER_SERIAL_EVENT_ERROR;
        }

        if (serial->receiving_found) {
            serial->found_payload[serial->found_payload_len++] = byte;
            if (serial->found_payload_len == sizeof(serial->found_payload)) {
                serial->receiving_found = false;
                serial->found_payload_len = 0;
                if (nonce != NULL) {
                    *nonce = ((uint32_t)serial->found_payload[0] << 24) |
                             ((uint32_t)serial->found_payload[1] << 16) |
                             ((uint32_t)serial->found_payload[2] << 8) |
                             serial->found_payload[3];
                }
                return TANGMINER_SERIAL_EVENT_FOUND;
            }
            continue;
        }

        if (serial->receiving_tagged_found) {
            serial->tagged_found_payload[serial->tagged_found_payload_len++] = byte;
            if (serial->tagged_found_payload_len == sizeof(serial->tagged_found_payload)) {
                serial->receiving_tagged_found = false;
                serial->tagged_found_payload_len = 0;
                if (tag != NULL) {
                    *tag = (uint16_t)(((uint16_t)serial->tagged_found_payload[0] << 8) |
                                      serial->tagged_found_payload[1]);
                }
                if (nonce != NULL) {
                    *nonce = ((uint32_t)serial->tagged_found_payload[2] << 24) |
                             ((uint32_t)serial->tagged_found_payload[3] << 16) |
                             ((uint32_t)serial->tagged_found_payload[4] << 8) |
                             serial->tagged_found_payload[5];
                }
                return TANGMINER_SERIAL_EVENT_TAGGED_FOUND;
            }
            continue;
        }

        if (byte == 'F') {
            serial->receiving_found = true;
            serial->found_payload_len = 0;
        } else if (byte == 'R') {
            serial->receiving_tagged_found = true;
            serial->tagged_found_payload_len = 0;
        } else if (byte == 'G') {
            return TANGMINER_SERIAL_EVENT_CONTINUOUS_ACK;
        } else if (byte == 'S') {
            return TANGMINER_SERIAL_EVENT_STOPPED;
        } else {
            return TANGMINER_SERIAL_EVENT_ERROR;
        }
    }
}

tangminer_serial_event_t tangminer_serial_read_event(
    tangminer_serial_t* serial, uint32_t* nonce, int timeout_ms) {
    return serial_read_event(serial, NULL, nonce, timeout_ms);
}

tangminer_serial_event_t tangminer_serial_read_tagged_event(
    tangminer_serial_t* serial, uint16_t* tag, uint32_t* nonce, int timeout_ms) {
    return serial_read_event(serial, tag, nonce, timeout_ms);
}

int tangminer_serial_negotiate_continuous(tangminer_serial_t* serial, int timeout_ms) {
    const uint8_t get_capability[] = {'T', 'N', 'G'};
    if (serial_write_all(serial, get_capability, sizeof(get_capability)) != 0) {
        return -1;
    }

    uint32_t ignored_nonce = 0;
    const tangminer_serial_event_t event =
        tangminer_serial_read_event(serial, &ignored_nonce, timeout_ms);
    if (event == TANGMINER_SERIAL_EVENT_CONTINUOUS_ACK) {
        return 1;
    }
    if (event == TANGMINER_SERIAL_EVENT_ERROR) {
        return -1;
    }

    serial->receiving_found = false;
    serial->found_payload_len = 0;
    (void)tcflush(serial->fd, TCIFLUSH);
    return 0;
}

void tangminer_serial_close(tangminer_serial_t* serial) {
    if (serial->fd >= 0) {
        close(serial->fd);
        serial->fd = -1;
    }
}
